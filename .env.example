# Local testing: copy to .env and run: npm run dev
# On your host (Render etc.) set these as environment variables instead.

# 'upi' = free, no gateway fee (you check UTRs yourself)   |   'razorpay' = automatic checks, small fee
PAYMENT_MODE=upi
PRICE_RS=10

# UPI mode: YOUR own UPI ID where the money should go
UPI_ID=yourname@okaxis
UPI_NAME=Your Name

# Razorpay mode only
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

ADMIN_PASSWORD=choose-a-long-random-password

# Free cloud database (Turso). Leave as-is for a local file while testing.
DB_URL=file:data.db
DB_TOKEN=
